---
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import MobileCta from '../components/layout/MobileCta.astro';
import About from '../components/sections/About.astro';
import Contact from '../components/sections/Contact.astro';
import Guide from '../components/sections/Guide.astro';
import Hero from '../components/sections/Hero.astro';
import Lightbox from '../components/sections/Lightbox.astro';
import Moments from '../components/sections/Moments.astro';
import Programs from '../components/sections/Programs.astro';
import Trust from '../components/sections/Trust.astro';
import { buildingAndFloors, instagramUrl, internationalPhone, site, streetAddress } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const description = `대전 대덕구 송촌동 ${site.name}. 보건복지부 지정 발달재활서비스·주간·방과후활동서비스 제공기관으로 감각통합·언어·놀이치료와 승마·VR·음악 활동을 1:1 맞춤으로 운영합니다. 상담 ${site.phone}`;
const tagline = '아이의 속도로, 한 걸음씩 쑥쑥';
const ogImage = new URL('/assets/img/og-image.jpg', site.url).href;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.name,
  alternateName: site.englishName,
  url: site.url,
  logo: new URL('/assets/img/logo.svg', site.url).href,
  image: ogImage,
  telephone: internationalPhone,
  address: {
    '@type': 'PostalAddress',
    streetAddress,
    addressLocality: site.address.district,
    addressRegion: site.address.region,
    addressCountry: 'KR',
  },
  sameAs: site.instagram.map(instagramUrl),
};
---

<BaseLayout title={`${site.name} | 대전 송촌동 발달재활 · 주간·방과후활동`} description={description}>
  <Fragment slot="meta">
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={site.url} />

    <!-- Open Graph (카카오톡 / SNS 미리보기) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={`${site.name} | ${tagline}`} />
    <meta
      property="og:description"
      content={`발달재활 치료부터 움직임 스튜디오, 승마·VR 체험까지. 대전 송촌동 ${buildingAndFloors}`}
    />
    <meta property="og:url" content={site.url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
  </Fragment>
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      type="image/webp"
      href="/assets/img/photos/hero-outdoor-1080.webp"
      imagesrcset="/assets/img/photos/hero-outdoor-720.webp 720w, /assets/img/photos/hero-outdoor-1080.webp 1080w"
      imagesizes="(min-width: 1024px) 500px, (min-width: 768px) 440px, 72vw"
      fetchpriority="high"
    />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>

  <a class="skip" href="#main">
    본문 바로가기
  </a>
  <Header home />
  <main id="main">
    <Hero />
    <Trust />
    <About />
    <Programs />
    <Guide />
    <Moments />
    <Contact />
  </main>
  <Footer />
  <MobileCta />
  <Lightbox />
  <script>
    import '../scripts/main';
  </script>
</BaseLayout>
