---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Grass from '../components/ui/Grass.astro';
import Icon from '../components/ui/Icon.astro';
import { notFoundGrass } from '../data/grass';
import { site } from '../data/site';
import '../styles/pages/not-found.css';
---

<BaseLayout title={`페이지를 찾을 수 없어요 | ${site.name}`} noindex viewport="width=device-width, initial-scale=1">
  <Header />
  <main class="nf">
    <Icon name="doodle" class="doodle" />
    <p class="eyebrow">404 · Not found</p>
    <h1>길을 잠깐 잃었어요</h1>
    <p>
      찾으시는 페이지가 없거나 주소가 바뀌었어요.
      <br />
      처음 화면에서 다시 시작해 볼까요?
    </p>
    <a class="btn btn--primary btn--lg" href="/">
      처음으로
    </a>
  </main>
  <Grass class="nf-grass" blades={notFoundGrass} hidden />
</BaseLayout>
