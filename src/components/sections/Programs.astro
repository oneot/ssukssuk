---
import { programs } from '../../data/content';
import { photo } from '../../data/photos';
import Icon from '../ui/Icon.astro';

const { therapy, activities } = programs;
const delay = (index: number) => (index > 0 ? String(index) : undefined);
---

<section class="section programs" id="programs">
  <div class="container">
    <header class="section-head section-head--split" data-reveal>
      <div>
        <p class="eyebrow">
          <Icon name="sprout" />
          Programs
        </p>
        <h2>
          아이의 성향과 속도에 맞춘
          <br />
          프로그램
        </h2>
      </div>
      <p>
        아이마다 다른 발달 속도에 맞춰 1:1로 설계합니다. 치료실 안의 수업부터 몸으로 부딪히며 배우는 활동까지 함께해요.
      </p>
    </header>

    <div class="prog-group">
      <h3 class="group-label">
        <span class="mono">{therapy.label}</span>
        {therapy.title}
      </h3>
      <div class="prog-therapy">
        {therapy.cards.map((card, index) => (
          <article class="prog-card prog-card--icon glass" data-reveal data-reveal-delay={delay(index)}>
            <span class:list={['prog-icon', card.color === 'pink' && 'prog-icon--pink']}>
              <Icon name={card.icon} />
            </span>
            <h4>{card.title}</h4>
            <p>{card.text}</p>
            <ul class="chips">
              {card.chips.map((chip) => (
                <li>{chip}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>

    <div class="prog-group">
      <h3 class="group-label">
        <span class="mono">{activities.label}</span>
        {activities.title}
      </h3>
      <div class="prog-activities">
        {activities.cards.map((card, index) => {
          const image = photo(card.photo);
          return (
            <article class="prog-card prog-card--photo glass" data-reveal data-reveal-delay={delay(index)}>
              <div class="prog-photo">
                <img
                  src={image.small}
                  srcset={`${image.small} 800w, ${image.large} 1440w`}
                  sizes="(min-width: 1024px) 380px, (min-width: 768px) 45vw, 90vw"
                  width={image.width}
                  height={image.height}
                  alt={card.alt}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="prog-body">
                <h4>{card.title}</h4>
                <p>{card.text}</p>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </div>
</section>
