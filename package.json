{
  "name": "ssukssuk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build-static.mjs",
    "format": "prettier --write .",
    "lint": "prettier --check . && stylelint \"**/*.css\"",
    "validate": "html-validate \"dist/**/*.html\" && node scripts/check-dist.mjs",
    "baseline": "node scripts/prepare-baseline.mjs",
    "test": "playwright test",
    "test:visual": "playwright test --project=visual-chromium --project=visual-webkit",
    "test:e2e": "playwright test --project=e2e-chromium --project=e2e-webkit",
    "lhci": "lhci autorun"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.0",
    "html-validate": "11.16.2",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "pretendard": "1.3.9",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-recommended": "18.0.0"
  }
}
