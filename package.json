{
  "name": "ssukssuk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write .",
    "lint": "prettier --check . && stylelint \"src/**/*.css\" && node scripts/check-tokens.mjs && astro check",
    "validate": "html-validate \"dist/**/*.html\" && node scripts/check-dist.mjs",
    "baseline": "node scripts/prepare-baseline.mjs",
    "test": "playwright test",
    "test:visual": "playwright test --project=visual-chromium --project=visual-webkit",
    "test:e2e": "playwright test --project=e2e-chromium --project=e2e-webkit",
    "lhci": "lhci autorun",
    "optimize:svg": "svgo --config svgo.config.mjs --folder public/assets/img"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.0",
    "@types/pngjs": "6.0.5",
    "browserslist": "4.29.3",
    "cookie": "2.0.1",
    "html-validate": "11.16.2",
    "lightningcss": "1.33.0",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "stylelint": "17.16.0",
    "stylelint-config-recommended": "18.0.0",
    "stylelint-config-standard": "40.0.0",
    "svgo": "4.1.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "astro": "7.3.8",
    "pretendard": "1.3.9",
    "sharp": "0.35.5",
    "subset-font": "2.9.0",
    "yaml": "2.9.1"
  }
}
