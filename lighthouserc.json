{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "autodiscoverUrlBlocklist": ["/404.html"],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 3500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.01 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }],
        "resource-summary:total:size": ["error", { "maxNumericValue": 358400 }],
        "resource-summary:font:size": ["error", { "maxNumericValue": 204800 }],
        "resource-summary:image:size": ["error", { "maxNumericValue": 122880 }],
        "resource-summary:third-party:count": ["error", { "maxNumericValue": 0 }]
      },
      "aggregationMethod": "median-run"
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
